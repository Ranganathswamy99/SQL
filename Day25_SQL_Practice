-- ============================================
-- 📌 Dataset: employees
-- Columns: emp_id, emp_name, age, salary, department, city
-- ============================================

-- ============================================
-- 🔹 BASIC QUERIES
-- ============================================

-- 1. Get all employee details
SELECT * FROM employees;

-- 2. Get employee name and salary
SELECT emp_name, salary FROM employees;

-- 3. Employees with salary > 30000
SELECT * FROM employees WHERE salary > 30000;

-- 4. Employees from Bangalore
SELECT * FROM employees WHERE city = 'Bangalore';

-- 5. Employees with age < 25
SELECT * FROM employees WHERE age < 25;

-- 6. Employees in IT department
SELECT * FROM employees WHERE department = 'IT';

-- 7. Salary between 25000 and 50000
SELECT * FROM employees 
WHERE salary BETWEEN 25000 AND 50000;

-- 8. Names starting with 'A'
SELECT * FROM employees 
WHERE emp_name LIKE 'A%';

-- 9. Names ending with 'n'
SELECT * FROM employees 
WHERE emp_name LIKE '%n';

-- 10. Sort by salary descending
SELECT * FROM employees 
ORDER BY salary DESC;


-- ============================================
-- 🔹 AGGREGATE FUNCTIONS
-- ============================================

-- 11. Total number of employees
SELECT COUNT(*) FROM employees;

-- 12. Average salary
SELECT AVG(salary) FROM employees;

-- 13. Maximum salary
SELECT MAX(salary) FROM employees;


-- ============================================
-- 🔹 GROUP BY QUERIES
-- ============================================

-- 14. Number of employees in each department
SELECT department, COUNT(*) 
FROM employees 
GROUP BY department;

-- 15. Average salary in each department
SELECT department, AVG(salary) 
FROM employees 
GROUP BY department;


-- ============================================
-- 🔹 HAVING CLAUSE
-- ============================================

-- 16. Departments with more than 2 employees
SELECT department, COUNT(*) 
FROM employees 
GROUP BY department
HAVING COUNT(*) > 2;

-- 17. Departments with avg salary > 40000
SELECT department, AVG(salary) 
FROM employees 
GROUP BY department
HAVING AVG(salary) > 40000;

-- 18. Total salary of each department
SELECT department, SUM(salary) 
FROM employees 
GROUP BY department;
