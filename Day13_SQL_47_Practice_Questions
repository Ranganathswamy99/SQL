-- 1. Display all columns
SELECT * FROM employees;

-- 2. Display emp_name and salary
SELECT emp_name, salary FROM employees;

-- 3. Display employee names
SELECT emp_name FROM employees;

-- 4. Show employee name and city
SELECT emp_name, city FROM employees;

-- 5. Employees joined after 2020
SELECT * FROM employees WHERE joining_date > '2020-12-31';
-- OR
SELECT * FROM employees WHERE YEAR(joining_date) > 2020;

-- 6. Employees with salary > 50000
SELECT * FROM employees WHERE salary > 50000;

-- 7. Employees from Bangalore
SELECT * FROM employees WHERE city = 'Bangalore';

-- 8. Employees with age < 30
SELECT * FROM employees WHERE age < 30;

-- 9. Salary between 40000 and 80000
SELECT * FROM employees WHERE salary BETWEEN 40000 AND 80000;

-- 10. Employees not from Mumbai
SELECT * FROM employees WHERE city NOT IN ('Mumbai');

-- 11. Employees from multiple cities
SELECT * FROM employees 
WHERE city IN ('Bangalore', 'Hyderabad', 'Chennai');

-- 12. Employees not from Delhi and Mumbai
SELECT * FROM employees 
WHERE city NOT IN ('Delhi', 'Mumbai');

-- 13. Name starts with 'A'
SELECT * FROM employees WHERE emp_name LIKE 'A%';

-- 14. Name ends with 'n'
SELECT * FROM employees WHERE emp_name LIKE '%n';

-- 15. Name contains 'ra'
SELECT * FROM employees WHERE emp_name LIKE '%ra%';

-- 16. Highest salary
SELECT MAX(salary) FROM employees;

-- 17. Lowest salary
SELECT MIN(salary) FROM employees;

-- 18. Average salary
SELECT AVG(salary) FROM employees;

-- 19. Total salary paid
SELECT SUM(salary) FROM employees;

-- 20. Total employees
SELECT COUNT(*) FROM employees;

-- 21. Unique departments
SELECT DISTINCT department FROM employees;

-- 22. Count employees
SELECT COUNT(*) FROM employees;

-- 23. Count distinct cities
SELECT COUNT(DISTINCT city) FROM employees;

-- 24. Top 5 highest-paid employees
SELECT * FROM employees ORDER BY salary DESC LIMIT 5;

-- 25. First 3 employees
SELECT * FROM employees LIMIT 3;

-- 26. Sort by salary ascending
SELECT * FROM employees ORDER BY salary ASC;

-- 27. Sort by age descending
SELECT * FROM employees ORDER BY age DESC;

-- 28. Alias for emp_name
SELECT emp_name AS Employee_Name FROM employees;

-- 29. Alias for salary
SELECT salary AS Monthly_Salary FROM employees;

-- 30. Sort by department and salary
SELECT * FROM employees ORDER BY department ASC, salary ASC;

-- 31. Avg salary in Bangalore
SELECT AVG(salary) FROM employees WHERE city = 'Bangalore';

-- 32. Total salary in IT department
SELECT SUM(salary) FROM employees WHERE department = 'IT';

-- 33. Highest salary where age > 30
SELECT MAX(salary) FROM employees WHERE age > 30;

-- 34. Count employees in HR
SELECT COUNT(*) FROM employees WHERE department = 'HR';

-- 35. Min salary in Chennai
SELECT MIN(salary) FROM employees WHERE city = 'Chennai';

-- 36. Count employees per department
SELECT department, COUNT(*) 
FROM employees 
GROUP BY department;

-- 37. Avg salary per department
SELECT department, AVG(salary) 
FROM employees 
GROUP BY department;

-- 38. Total salary per city
SELECT city, SUM(salary) 
FROM employees 
GROUP BY city;

-- 39. Departments with more than 5 employees
SELECT department, COUNT(*) 
FROM employees 
GROUP BY department 
HAVING COUNT(*) > 5;

-- 40. Cities with avg salary > 60000
SELECT city, AVG(salary) 
FROM employees 
GROUP BY city 
HAVING AVG(salary) > 60000;

-- 41. Department with highest avg salary
SELECT department, AVG(salary) AS avg_salary 
FROM employees 
GROUP BY department 
ORDER BY avg_salary DESC 
LIMIT 1;

-- 42. Cities with more than 3 employees
SELECT city, COUNT(*) 
FROM employees 
GROUP BY city 
HAVING COUNT(*) > 3;

-- 43. Second highest salary
SELECT MAX(salary) 
FROM employees 
WHERE salary < (SELECT MAX(salary) FROM employees);

-- 44. Employees earning above average salary
SELECT * 
FROM employees 
WHERE salary > (SELECT AVG(salary) FROM employees);

-- 45. Duplicate employee names
SELECT emp_name, COUNT(*) 
FROM employees 
GROUP BY emp_name 
HAVING COUNT(*) > 1;

-- 46. Employees with same salary
SELECT salary, COUNT(*) 
FROM employees 
GROUP BY salary 
HAVING COUNT(*) > 1;

-- 47. Department with highest total salary
SELECT department, SUM(salary) AS total_salary 
FROM employees 
GROUP BY department 
ORDER BY total_salary DESC 
LIMIT 1;
