-- Dataset: orders
-- orders(order_id, customer_name, product, category, price, quantity, order_date, city)

--------------------------------------------------
-- 🔹 Filtering & Conditions
--------------------------------------------------

-- 1. Orders where price > 2000
SELECT * 
FROM orders 
WHERE price > 2000;

-- 2. Orders from Mumbai with quantity > 1
SELECT * 
FROM orders 
WHERE city = 'Mumbai' AND quantity > 1;

-- 3. Products starting with 'M'
SELECT * 
FROM orders 
WHERE product LIKE 'M%';

--------------------------------------------------
-- 🔹 Aggregations & GROUP BY
--------------------------------------------------

-- 4. Total revenue per category
SELECT category, SUM(price * quantity) AS total_revenue
FROM orders
GROUP BY category;

-- 5. Top 3 most expensive orders
SELECT * 
FROM orders 
ORDER BY price DESC 
LIMIT 3;

-- 6. Count orders per city
SELECT city, COUNT(*) AS total_orders
FROM orders
GROUP BY city;

--------------------------------------------------
-- 🔹 GROUP BY with HAVING
--------------------------------------------------

-- 7. Average price per city where avg price > 2000
SELECT city, AVG(price) AS avg_price
FROM orders
GROUP BY city
HAVING AVG(price) > 2000;

--------------------------------------------------
-- 🔹 Business Logic Queries
--------------------------------------------------

-- 8. Category with highest total revenue
SELECT category, SUM(price * quantity) AS total_revenue
FROM orders
GROUP BY category
ORDER BY total_revenue DESC
LIMIT 1;

-- 9. Customers with more than 1 order
SELECT customer_name, COUNT(*) AS order_count
FROM orders
GROUP BY customer_name
HAVING COUNT(*) > 1;

-- 10. Total revenue per city (highest to lowest)
SELECT city, SUM(price * quantity) AS total_revenue
FROM orders
GROUP BY city
ORDER BY total_revenue DESC;
