-- Dataset: employees
-- employees(emp_id, emp_name, age, salary, department, city)

--------------------------------------------------
-- 🔹 Basic SELECT & WHERE
--------------------------------------------------

SELECT * FROM employees;

SELECT emp_name, salary FROM employees;

SELECT * FROM employees WHERE salary > 30000;

SELECT * FROM employees WHERE city = 'Bangalore';

SELECT * FROM employees WHERE age < 25;

--------------------------------------------------
-- 🔹 Conditions
--------------------------------------------------

SELECT * FROM employees WHERE salary BETWEEN 20000 AND 50000;

SELECT * FROM employees WHERE city NOT IN ('Delhi');

SELECT * FROM employees WHERE city IN ('Mumbai', 'Chennai', 'Bangalore');

SELECT * FROM employees 
WHERE department = 'IT' AND salary > 40000;

SELECT * FROM employees 
WHERE age > 25 OR salary > 50000;

--------------------------------------------------
-- 🔹 LIKE (Pattern Matching)
--------------------------------------------------

SELECT * FROM employees WHERE emp_name LIKE 'A%';

SELECT * FROM employees WHERE emp_name LIKE '%n';

SELECT * FROM employees WHERE emp_name LIKE '%ra%';

--------------------------------------------------
-- 🔹 ORDER BY & LIMIT
--------------------------------------------------

SELECT * FROM employees ORDER BY salary ASC;

SELECT * FROM employees ORDER BY age DESC;

SELECT * FROM employees ORDER BY salary DESC LIMIT 3;

SELECT * FROM employees ORDER BY salary ASC LIMIT 1;

--------------------------------------------------
-- 🔹 Aggregate Functions
--------------------------------------------------

SELECT MAX(salary) FROM employees;

SELECT MIN(salary) FROM employees;

SELECT AVG(salary) FROM employees;

SELECT SUM(salary) FROM employees;

SELECT COUNT(*) FROM employees;

--------------------------------------------------
-- 🔹 GROUP BY
--------------------------------------------------

SELECT department, COUNT(*) 
FROM employees 
GROUP BY department;

SELECT department, AVG(salary) 
FROM employees 
GROUP BY department;

SELECT city, SUM(salary) 
FROM employees 
GROUP BY city;

--------------------------------------------------
-- 🔹 HAVING
--------------------------------------------------

SELECT department, COUNT(*) 
FROM employees 
GROUP BY department 
HAVING COUNT(*) > 2;

SELECT city, AVG(salary) 
FROM employees 
GROUP BY city 
HAVING AVG(salary) > 30000;
