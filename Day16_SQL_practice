-- Dataset: orders
-- orders(order_id, customer_name, product, category, price, quantity, order_date, city)

--------------------------------------------------
-- 🔹 Filtering & Conditions
--------------------------------------------------

-- 1. Orders where price > 3000 and not from Bangalore
SELECT * 
FROM orders 
WHERE price > 3000 
AND city != 'Bangalore';

-- 2. Products containing 'a' and quantity >= 2
SELECT * 
FROM orders 
WHERE product LIKE '%a%' 
AND quantity >= 2;

--------------------------------------------------
-- 🔹 Aggregations & GROUP BY
--------------------------------------------------

-- 3. Total quantity sold per category
SELECT category, SUM(quantity) AS total_quantity
FROM orders
GROUP BY category;

-- 4. Average quantity per city
SELECT city, AVG(quantity) AS avg_quantity
FROM orders
GROUP BY city;

-- 5. Cities where total quantity > 2
SELECT city, SUM(quantity) AS total_quantity
FROM orders
GROUP BY city
HAVING SUM(quantity) > 2;

--------------------------------------------------
-- 🔹 Revenue-Based Business Queries
--------------------------------------------------

-- 6. Top 2 cities with highest revenue
SELECT city, SUM(price * quantity) AS total_revenue
FROM orders
GROUP BY city
ORDER BY total_revenue DESC
LIMIT 2;

-- 7. Product with highest total quantity sold
SELECT product, SUM(quantity) AS total_quantity
FROM orders
GROUP BY product
ORDER BY total_quantity DESC
LIMIT 1;

-- 8. City with lowest total revenue
SELECT city, SUM(price * quantity) AS total_revenue
FROM orders
GROUP BY city
ORDER BY total_revenue ASC
LIMIT 1;
